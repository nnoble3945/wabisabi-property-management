# For local development ONLY; never enable in production.
DEV_AUTH_BYPASS=true

# Azure SQL. Leave unset to start the UI in setup mode.
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=

# Local development ONLY, optional alternative to az login identity.
# SQL_USER=
# SQL_PASSWORD=

# Production: require Entra sign-in at App Service edge and explicitly allow users.
# APP_AUTH_MODE=azure
# ALLOWED_PRINCIPAL_IDS=entra-object-id-1,entra-object-id-2
